# Inject environment variables through your process manager or Docker --env-file.
# app.py does not automatically read .env. All values below are placeholders.
# The local Compose launcher uses private .local/config.json instead; see SELF_HOSTING.md.
ESPN_FANTASY_YEAR=2026
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
# Required (>=24 chars) when listening on a network interface.
APP_ACCESS_TOKEN=
# Only for a trusted reverse proxy: exact browser-facing HTTP(S) origin, e.g.
# https://trades.example.com (include non-default port; no trailing slash/path).
# Leave empty for direct HTTP. Forwarded headers do not configure origin trust.
# Also configure --allowed-host for the deployed hostname.
APP_PUBLIC_ORIGIN=
# AI stays off unless explicitly enabled with provider/key configured locally.
# Then UI/CLI run controls default on; uncheck in UI or use CLI --no-llm to opt out.
# API clients must explicitly send the literal JSON boolean use_llm: true.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
